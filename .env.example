# Antifraud Verify – variabili d'ambiente locali
# ⚠️ Non committare questo file su GitHub! (già nel .gitignore)

# ID del tuo Google Sheet (dalla URL del foglio)
# es: https://docs.google.com/spreadsheets/d/1AbCdEf.../edit
GOOGLE_SHEET_ID=incolla_qui_il_tuo_sheet_id

# JSON della Service Account Google (tutto su una riga)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}
